# Port server lokal (npm start)
PORT=3000
# Data dibaca ulang dari warehouse paling sering sekali per CACHE_SECONDS (min 5),
# berapa pun orang yang membuka dashboard. Halaman juga memuat ulang otomatis
# tiap max(CACHE_SECONDS, 30) detik.
CACHE_SECONDS=60

# --- Event ---
EVENT_NAMA=Imperfect Sale 2026
# Rentang tanggal event (WIB, YYYY-MM-DD). Day 1 = EVENT_DARI.
EVENT_DARI=2026-10-30
EVENT_SAMPAI=2026-11-01
# Gudang event di laporan_penjualan, dipisah koma (sama dengan PG_QUERY papan TV).
EVENT_WAREHOUSE=MAIN IMPERFECT WAREHOUS 2026, TEBUS MURAH IMPERFECT 2026
# Kolom yang menjadi kolom "channel" di tabel: warehouse (bawaan) atau channel.
KOLOM_CHANNEL=warehouse
# Jadwal sesi: satu hari per baris, atau dipisah titik koma. Nomor sesi otomatis
# menurut urutan jam. Transaksi di luar rentang masuk baris "Di luar sesi".
# Di Vercel boleh ditempel multi-baris.
EVENT_SESI=Day 1: 09.00-10.00, 13.00-14.00, 15.00-16.00, 17.00-18.00, 19.00-20.00; Day 2: 09.00-10.00, 11.00-12.00, 13.00-14.00, 15.00-16.00, 17.00-18.00, 19.00-20.00; Day 3: 09.00-10.00, 11.00-12.00, 13.00-14.00, 15.00-16.00, 17.00-18.00, 19.00-20.00

# --- Postgres: warehouse we_data_store, tabel laporan_penjualan ---
# Sama dengan IMPERPECT-SALES-2026 / OFFLINE-STORE: pakai user read-only.
# Pilih SALAH SATU cara; kalau keduanya terisi, DATABASE_URL yang dipakai.
# Kosong semua = mode demo (data contoh).
#
# a. Variabel terpisah (disarankan): password ditulis apa adanya, tanpa encode.
#    Di .env SELALU apit dengan kutip tunggal: tanpa kutip, # dibaca sebagai komentar.
#    Di Vercel tempel tanpa kutip.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=''
DATABASE_NAME=we_data_store
#
# b. Satu URL: tanda baca di password harus di-encode (# -> %23, / -> %2F, ? -> %3F, @ -> %40).
# DATABASE_URL=postgres://readonly:password@host:5432/we_data_store
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true
# Schema tabel laporan_penjualan bila bukan di search_path (mis. mysql_db_store).
# DB_SCHEMA=
# Opsional: ganti seluruh query (tanpa parameter). Kolom keluarannya harus sama dengan
# query bawaan di server/source-postgres.js.
# PG_QUERY=

# --- Brand eksternal (tab Ringkasan Eksternal) ---
# Satu Google Sheet per brand di satu folder Drive (sama dengan Sheet brand papan TV).
# Nama file = nama brand; kolom: No HP, Nama, qty, trx value. Folder di-share ke email
# akun layanan sebagai Viewer. Kosong = data contoh di tab itu.
DRIVE_FOLDER=
# Isi file key JSON akun layanan, satu baris (di .env apit kutip tunggal; di Vercel tempel apa adanya).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Atau dua variabel (private_key boleh dengan \n literal):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=dash@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# DRIVE_MAX_ROWS=5000

# --- Mode uji ---
# Selama mode uji aktif, dashboard TIDAK membaca gudang/tanggal event di atas,
# melainkan UJI_LIMIT baris pertama gudang UJI_WAREHOUSE (tanpa batas tanggal),
# dengan Day 1 = tanggal transaksi pertamanya. Bawaan kode: aktif untuk
# MAIN STAGE IMPERFECT SALE 2025, 20 baris. Isi off untuk membaca event 2026.
# UJI_WAREHOUSE=off
# UJI_LIMIT=20

# --- Akses ---
# Kosong = dashboard terbuka tanpa login.
# Diisi = semua data perlu login dengan password ini.
DASHBOARD_PASSWORD=
# Opsional: kunci tambahan tanda tangan cookie sesi. Mengganti nilai ini
# (atau password) mengeluarkan semua sesi.
# SESSION_SECRET=

# Paksa data contoh walau database terisi.
# DEMO_MODE=false
